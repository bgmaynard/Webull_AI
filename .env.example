# Copy this file to .env and fill in your values
# cp .env.example .env

# Broker selection: alpaca | webull | sim
BROKER_PROVIDER=sim
# Market data selection: polygon | webull | sim
MARKET_DATA_PROVIDER=sim

# Alpaca (when BROKER_PROVIDER=alpaca)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Polygon.io (when MARKET_DATA_PROVIDER=polygon)
POLYGON_API_KEY=

# Webull Credentials (when BROKER_PROVIDER=webull)
WEBULL_DEVICE_ID=
WEBULL_EMAIL=
WEBULL_PASSWORD=
WEBULL_TRADING_PIN=
WEBULL_ACCOUNT_TYPE=paper

# Simulation (when BROKER_PROVIDER=sim)
SIM_STARTING_CASH=500

# Server
BOT_PORT=9300
